# Perceptify setup
# 1. Make a copy of this file and name the copy exactly:  .env
#    (run.sh does this for you on first start)
# 2. Paste your free Gemini API key below, then save.
#    Get one at Google AI Studio -> "Get API key". No credit card needed.
# 3. Never share your .env file or commit it to GitHub.

# Required: Gemini API key (the app uses a Gemini Flash model)
GEMINI_API_KEY=paste-your-gemini-key-here

# Optional: YouTube Data API v3 key. Leave empty to use the built-in no-key scraper.
YOUTUBE_API_KEY=

# Optional: force a specific Gemini model. Leave empty for automatic (Flash).
GEMINI_MODEL=

# Optional: set to 1 to see demo data without any keys
MOCK_MODE=0
