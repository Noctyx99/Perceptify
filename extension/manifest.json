{
  "manifest_version": 3,
  "name": "Perceptify",
  "version": "3.0.0",
  "description": "See how they see it. One click reads a YouTube comment section: audience mood, themes with receipts, and the exact moments people reacted to.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_title": "Perceptify: read the room",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.css", "fonts/*.woff2"], "matches": ["https://www.youtube.com/*"] }
  ]
}
